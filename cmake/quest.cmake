file(READ "${CMAKE_CURRENT_SOURCE_DIR}/qpm2.json" PACKAGE_JSON)
string(JSON MOD_ID GET "${PACKAGE_JSON}" id)
string(JSON MOD_VERSION GET "${PACKAGE_JSON}" version)
string(JSON EXTERN_DIR_NAME GET "${PACKAGE_JSON}" dependenciesDirectory)
string(JSON SHARED_DIR_NAME GET "${PACKAGE_JSON}" sharedDirectory)
set(COMPILE_ID "${MOD_ID}")
set(CODEGEN_ID codegen)
set(EXTERN_DIR "${CMAKE_CURRENT_SOURCE_DIR}/${EXTERN_DIR_NAME}")
set(SHARED_DIR "${CMAKE_CURRENT_SOURCE_DIR}/${SHARED_DIR_NAME}")

if (NOT DEFINED CMAKE_ANDROID_NDK)
    if (EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/ndkpath.txt")
        file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/ndkpath.txt" CMAKE_ANDROID_NDK)
    elseif (DEFINED ENV{ANDROID_NDK_HOME})
        set(CMAKE_ANDROID_NDK "$ENV{ANDROID_NDK_HOME}")
    elseif (DEFINED ENV{ANDROID_NDK_LATEST_HOME})
        set(CMAKE_ANDROID_NDK "$ENV{ANDROID_NDK_LATEST_HOME}")
    endif()
endif()
if (NOT CMAKE_ANDROID_NDK)
    message(FATAL_ERROR "NDK not found; run qpm2 ndk resolve -d")
endif()
file(TO_CMAKE_PATH "${CMAKE_ANDROID_NDK}" CMAKE_ANDROID_NDK)
set(ANDROID_PLATFORM 24)
set(ANDROID_ABI arm64-v8a)
set(ANDROID_STL c++_static)
set(ANDROID_USE_LEGACY_TOOLCHAIN_FILE OFF)
set(CMAKE_TOOLCHAIN_FILE "${CMAKE_ANDROID_NDK}/build/cmake/android.toolchain.cmake")
